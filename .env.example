# Kopieer dit bestand naar .env.local en vul je eigen keys in.
# .env.local wordt niet meegecommit (zie .gitignore).
#
# Beide keys zijn publiek (ze komen in de frontend-bundle) — dat is bij Web3Forms en
# Cloudflare Turnstile zo bedoeld; er zitten geen geheimen in.

# Web3Forms access key — https://web3forms.com (registreer svwabbekerk1913@gmail.com)
VUE_APP_WEB3FORMS_ACCESS_KEY=

# Bot-check: hCaptcha via Web3Forms. Standaard wordt Web3Forms' gedeelde sleutel gebruikt
# (gratis, server-side gevalideerd) — hier hoeft niets ingevuld te worden.
# Alleen invullen voor een eigen hCaptcha-account.
# VUE_APP_HCAPTCHA_SITEKEY=
